# Copy to .env and fill in — never commit the real .env (it is gitignored).
#
# Map provider keys (get them from your team vault). Both are OPTIONAL:
# the Flask backend reads them at request time and serves them to the
# frontend via /api/config, so one Docker image works across environments.
#   MAPBOX_KEY      → enables the SntMap vector street basemap (Mapbox GL,
#                     tinted with the Sensolus tokens — the same basemap the
#                     platform renders) and the satellite layer + toggle.
#                     Without it, street tiles fall back to raster and there
#                     is no satellite layer.
#   LOCATIONIQ_KEY  → enables the SntMap geocoder and the premium raster street
#                     tiles used when the vector basemap is unavailable (no
#                     MAPBOX_KEY, or no WebGL). Without it, raster falls back
#                     to OpenStreetMap and the geocoder is disabled.
MAPBOX_KEY=
LOCATIONIQ_KEY=

# The Sensolus platform, and an API key of the organisation this app is for. The key is
# only used by `node scripts/update-openapi.mjs`, which downloads the API spec tailored
# to it into openapi.json. The key's role decides which endpoints that spec lists, so use
# one with the role the app needs: a read-only key gives a spec without any write endpoint.
# The backend reads SENSOLUS_DOMAIN too (default shown).
SENSOLUS_DOMAIN=cloud.sensolus.com
SENSOLUS_API_KEY=

# PostgreSQL connection (defaults shown; see README "Database Configuration")
#DB_HOST=localhost
#DB_PORT=5432
#DB_NAME={{APP_NAME}}
#DB_USER=snt
#DB_PASSWORD=snt
